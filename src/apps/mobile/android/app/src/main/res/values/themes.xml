<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BitFunGlasses" parent="Theme.AppCompat.NoActionBar">
        <!-- Opaque black so the launcher app list cannot show through. -->
        <item name="android:windowBackground">@color/bf_black</item>
        <item name="android:colorBackground">@color/bf_black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColorPrimary">@color/bf_white</item>
        <item name="android:textColorSecondary">@color/bf_muted</item>
        <item name="android:statusBarColor">@color/bf_black</item>
        <item name="android:navigationBarColor">@color/bf_black</item>
        <item name="colorPrimary">@color/bf_accent</item>
        <item name="colorAccent">@color/bf_accent</item>
        <item name="android:buttonStyle">@style/Widget.BitFunGlasses.Button</item>
        <item name="buttonStyle">@style/Widget.BitFunGlasses.Button</item>
    </style>

    <style name="Widget.BitFunGlasses.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/vr_button_min_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/bg_frost_button</item>
        <item name="android:textColor">@color/bf_white</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>
</resources>
