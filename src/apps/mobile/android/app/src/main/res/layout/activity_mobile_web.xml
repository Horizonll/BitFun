<?xml version="1.0" encoding="utf-8"?>
<!-- Single-eye pane inflated twice by BaseMirrorActivity (left + right). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobileWebRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bf_black">

    <!-- Left eye: live SPA WebView. Right eye hides this and shows [eyeMirror]. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bf_black" />

    <!-- Right eye: pixel clone of the left WebView (no second SPA runtime). -->
    <ImageView
        android:id="@+id/eyeMirror"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bf_black"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <!-- Kept for view-binding id stability; never shown (no page-load spinner). -->
    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
